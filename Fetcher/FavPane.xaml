<UserControl x:Class="ImageSelector.FavPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="FavPaneControl"
             Background="#F6F6F6"
             ClipToBounds="True"
             Focusable="False">
    <!-- 左侧 fav 面板：纯媒体看图区，不承担目录浏览。
         面包屑、文件名、提示、圆点都不要；空列表时只露出主题背景。 -->
    <Grid x:Name="PaneRoot"
          Background="Transparent"
          PreviewMouseWheel="Pane_PreviewMouseWheel"
          PreviewMouseDown="Pane_PreviewMouseDown"
          PreviewMouseMove="Pane_PreviewMouseMove"
          PreviewMouseUp="Pane_PreviewMouseUp"
          LostMouseCapture="Pane_LostMouseCapture"
          SizeChanged="Pane_SizeChanged">
        <Image x:Name="FavImage"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               RenderTransformOrigin="0,0"
               Visibility="Collapsed"
               MouseMove="FavMedia_MouseMove">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FavImageScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="FavImageTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- 和右侧一样单独一层；MediaElement 是 HWND 合成表面，空 Source 时仍会画黑底，
             所以不用时必须显式 Collapsed。 -->
        <MediaElement x:Name="FavVideo"
                      Focusable="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      RenderTransformOrigin="0,0"
                      Visibility="Collapsed"
                      IsMuted="True"
                      ScrubbingEnabled="False"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      MediaOpened="FavVideo_MediaOpened"
                      MediaFailed="FavVideo_MediaFailed"
                      MediaEnded="FavVideo_MediaEnded"
                      MouseMove="FavMedia_MouseMove">
            <MediaElement.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FavVideoScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="FavVideoTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </MediaElement.RenderTransform>
        </MediaElement>

        <Border x:Name="FavMotionRecordingBorder"
                BorderBrush="Red" BorderThickness="2"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
    </Grid>
</UserControl>